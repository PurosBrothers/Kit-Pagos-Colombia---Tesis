{
  "name": "checkout-frontend-rest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototipo C: checkout de navegador que cobra contra la API REST de Kit Pagos (/v1/api) sin instalar el SDK (issue #109)",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:sri": "node scripts/check-sri.mjs",
    "start": "node server.mjs",
    "start:local": "node server.mjs --api-url=http://localhost:3000/v1/api",
    "start:sandbox": "node server.mjs --environment=sandbox"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^6.0.3",
    "vite": "^5.4.14",
    "vitest": "^3.2.7"
  }
}
