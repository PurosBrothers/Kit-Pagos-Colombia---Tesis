# Copie este archivo como ".env" en la raíz del repo y complete los valores
# reales. El archivo ".env" NUNCA debe subirse a git (ya está en .gitignore).
#
# Sección 1: credenciales de acceso a los paneles de cada proveedor.
# Uso: administración de cuentas, obtención de API keys, configuración de
# webhooks. NO son las credenciales que el SDK usa para llamar a cada API.
#
# Sección 2: las API keys de sandbox que consumen las pruebas de contrato
# (`cd sdk && npm run test:sandbox`). Se obtienen DENTRO de cada panel de la
# sección 1. Dónde encontrar cada una está documentado pasarela por pasarela en
# docs/testing-data/, y el mapeo completo en
# docs/03-sdk/4-guia-de-implementacion.md sección 2.
#
# Las pruebas de contrato leen este archivo directamente desde la raíz. Si
# faltan las credenciales de una pasarela, sus pruebas se **saltan**, no
# fallan: una prueba roja por una credencial que falta enseña a ignorar el rojo.

# ---------------------------------------------------------------------------
# 1. Credenciales de acceso a los paneles
# ---------------------------------------------------------------------------

KUSHKI_DASHBOARD_USERNAME=
KUSHKI_DASHBOARD_PASSWORD=

NPM_ACCOUNT_USERNAME=
NPM_ACCOUNT_PASSWORD=

MERCADOPAGO_DASHBOARD_USERNAME=
MERCADOPAGO_DASHBOARD_PASSWORD=

RAPYD_DASHBOARD_USERNAME=
RAPYD_DASHBOARD_PASSWORD=

WOMPI_DASHBOARD_USERNAME=
WOMPI_DASHBOARD_PASSWORD=

RENDER_DASHBOARD_USERNAME=
RENDER_DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# 2. API keys de sandbox — las que consumen las pruebas de contrato
# ---------------------------------------------------------------------------

# Wompi es la única de las cuatro con cuatro secretos, y los dos últimos no son
# intercambiables: INTEGRITY firma las transacciones que salen y EVENTS valida
# los webhooks que entran. Sin INTEGRITY, Wompi responde
# 422 "Firma de integridad requerida no enviada" y no crea nada (punto 50).
# La API de Simulación verifica la firma con este mismo secreto; sin él, con su
# valor por omisión, test_integrity_kit_pagos_simulator (punto 86).
# El prototipo C (prototypes/checkout-frontend-rest) lee de este archivo solo
# WOMPI_PUBLIC_KEY, MERCADOPAGO_PUBLIC_KEY y KUSHKI_PUBLIC_KEY, para tokenizar la
# tarjeta en el navegador. Tienen que ser del mismo par que usa la API (con npm start,
# el de Render): el navegador crea el token con estas y la API lo cobra con las suyas.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Rapyd firma cada petición, no solo los webhooks: el par de claves se usa para
# calcular un HMAC por llamada. La API de Simulación verifica esa firma con este
# mismo secreto; sin él, con su valor por omisión, rapyd_secret_kit_pagos_simulator
# (punto 86).
RAPYD_API_ACCESS_KEY=
RAPYD_API_SECRET_KEY=
# URL registrada en el panel de Rapyd para recibir webhooks, escrita exactamente igual
# que allí. Rapyd la incluye en la firma y no la envía, así que sin ella ningún webhook
# de Rapyd se puede verificar (punto 67).
RAPYD_WEBHOOK_URL=

# En Mercado Pago el ACCESS_TOKEN es el que autentica las llamadas del servidor;
# el PUBLIC_KEY es para tokenizar la tarjeta en el frontend (y el que lee el
# prototipo C). El par tiene que ser el de «Credenciales de prueba» de una aplicación
# de Checkout API vía Orders, de un vendedor de prueba (empieza con APP_USR-). Un par
# TEST- sirve para la tarjeta por la API de Payments, pero la de Orders, que es la del
# PSE, le responde 401 (medido el 15 de octubre de 2026).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Kushki los llama "merchant id" pero funcionan como claves pública y privada.
# La API de Simulación acepta KUSHKI_WEBHOOK_SIGNATURE_ID como otro nombre de
# KUSHKI_WEBHOOK_SECRET, y lo usa cuando este está vacío.
KUSHKI_PUBLIC_MERCHANT_ID=
KUSHKI_PRIVATE_MERCHANT_ID=
KUSHKI_WEBHOOK_SECRET=
# El mismo valor de KUSHKI_PUBLIC_MERCHANT_ID. Solo lo lee el prototipo C, que busca las
# llaves públicas como <PASARELA>_PUBLIC_KEY sin nombrar pasarelas (punto 106).
KUSHKI_PUBLIC_KEY=

RENDER_DEPLOY_HOOK_URL=

# ---------------------------------------------------------------------------
# 3. Variables de la API de Simulación (REST Wrapper)
# ---------------------------------------------------------------------------
# La API lee, de los que existan, este archivo, el .env del directorio desde el que
# arranca, el de su directorio padre y /etc/secrets/.env (el Secret File de Render). De
# cada variable se queda con el primer valor que encuentra en ese orden, y el entorno del
# proceso gana sobre todos. Los valores van sin comillas: ese lector no las quita. Ver la
# sección 4.2 de docs/02-arquitectura/4-despliegue-en-render-y-coleccion-postman.md.

# PORT y HOST: dónde escucha la API; sin valor, 3000 y 0.0.0.0. Del mismo PORT salen las
# URL que la API arma hacia sí misma cuando SIMULATOR_SDK_BASE_URL no está definida, así
# que siempre coinciden con el puerto en el que escucha. Un PORT que no sea un entero entre
# 1 y 65535 detiene el arranque. En Render, PORT lo fija render.yaml (10000).
PORT=
HOST=

# API_AUTH_TOKEN: Token Bearer requerido para proteger los endpoints REST (/v1/api/*)
# de simulator-api. Si no se define, opera en modo desarrollo abierto sin exigir auth.
# Nota: /health y los endpoints mock /v1/sim/* quedan exentos.
# Si está vacío, se usa SIMULATOR_API_AUTH_TOKEN, que es otro nombre para lo mismo.
API_AUTH_TOKEN=

# SIMULATOR_SDK_BASE_URL: URL base pública o interna para que las peticiones al
# simulador apunten al propio despliegue (ej. en Render: https://kit-pagos-colombia.onrender.com).
# Si no se define, usa el propio proceso: http://localhost:${PORT}/v1/sim/<pasarela> (3000 sin PORT).
# Nota: La resolución de ambientes para pasarelas reales (sandbox o production) se
# declara dinámicamente por petición mediante la cabecera 'x-kit-pagos-environment'
# y se resuelve contra un catálogo cerrado en el SDK (Issue #123).
SIMULATOR_SDK_BASE_URL=

# SIMULATOR_PUBLIC_ORIGIN: origen público del simulador (protocolo://host, sin ruta) para las
# URL que entrega a quien lo usa: las páginas de banco del PSE de las cuatro pasarelas, la del
# checkout de Rapyd y el permalink de los términos de Wompi. Hace falta detrás de un proxy que
# termina TLS, como Render (ej. https://kit-pagos-colombia.onrender.com). Si no se define, usa
# el protocolo y el Host de cada petición. Un valor inválido detiene el arranque.
SIMULATOR_PUBLIC_ORIGIN=

# SIMULATOR_TRUST_FORWARDED_FOR: con "true", la IP del pagador que POST /v1/api/payments
# completa cuando el cuerpo no trae ipAddress sale del primer valor de X-Forwarded-For y no
# del socket. La API la necesita para el PSE de Mercado Pago, que exige la IP, y un
# navegador no la conoce (punto 92). Solo detrás de un proxy que escriba esa cabecera, como
# Render, donde vale "true" (render.yaml); en local se deja vacía. Sin ese proxy, cualquier
# cliente pondría en la cabecera la IP que quisiera.
SIMULATOR_TRUST_FORWARDED_FOR=

# WEBHOOK_TOLERANCE_SECONDS: ventana contra reenvíos de POST /v1/api/webhooks/:gateway,
# en segundos. Si no se define, usa la del SDK (300); 0 la desactiva. Es configuración
# del servidor a propósito: ninguna petición puede ampliarla.
WEBHOOK_TOLERANCE_SECONDS=

# SIMULATOR_WEBHOOK_TARGET_URL: único destino de los webhooks que emite el simulador, tanto
# del trigger como de la emisión automática. Admite el marcador {gateway} para separar las
# pasarelas en un mismo receptor. Si no se define, no sale ningún webhook y el trigger
# devuelve el webhook firmado en la respuesta. Un destino que no sea http o https, o que
# lleve usuario y clave, detiene el arranque. Es configuración del servidor a propósito:
# ninguna petición puede elegir el destino (SSRF). Ver la sección 4.2 de
# docs/02-arquitectura/3-api-de-simulacion.md.
SIMULATOR_WEBHOOK_TARGET_URL=

# SIMULATOR_WEBHOOK_AUTO: con "true" y un destino en SIMULATOR_WEBHOOK_TARGET_URL, emite un
# webhook en cada cambio de estado de un cobro. Si no se define, o vale otra cosa, queda
# apagada. Con "true" y sin destino también queda apagada, y lo advierte en el log.
SIMULATOR_WEBHOOK_AUTO=

# SIMULATOR_WEBHOOK_TIMEOUT_MS: cuánto espera el envío de un webhook, en milisegundos. Si no
# se define, o no es un entero positivo, usa 5000.
SIMULATOR_WEBHOOK_TIMEOUT_MS=

# SIMULATOR_SLOW_RESPONSE_MS: cuánto espera el escenario SLOW (montos 10003 y 10604) antes de
# responder el 504 nativo, en milisegundos. Si no se define, o no es un entero positivo, usa
# 35000, más que el límite de 30 s por petición que el SDK usa por omisión. Se lee en cada
# petición, no al arrancar.
SIMULATOR_SLOW_RESPONSE_MS=

