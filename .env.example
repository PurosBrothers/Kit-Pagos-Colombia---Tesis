# Copia este archivo como ".env" en la raíz del repo y completá los valores
# reales. El archivo ".env" NUNCA debe subirse a git (ya está en .gitignore).
#
# Sección 1: credenciales de acceso a los paneles de cada proveedor.
# Uso: administración de cuentas, obtención de API keys, configuración de
# webhooks. NO son las credenciales que el SDK usa para llamar a cada API.
#
# Sección 2: las API keys de sandbox que consumen las pruebas de contrato
# (`cd sdk && npm run test:sandbox`). Se obtienen DENTRO de cada panel de la
# sección 1. Dónde encontrar cada una está documentado pasarela por pasarela en
# docs/testing-data/, y el mapeo completo en
# docs/03-sdk/4-guia-de-implementacion.md sección 2.
#
# Las pruebas de contrato leen este archivo directamente desde la raíz. Si
# faltan las credenciales de una pasarela, sus pruebas se **saltan**, no
# fallan: una prueba roja por una credencial que falta enseña a ignorar el rojo.

# ---------------------------------------------------------------------------
# 1. Credenciales de acceso a los paneles
# ---------------------------------------------------------------------------

KUSHKI_DASHBOARD_USERNAME=
KUSHKI_DASHBOARD_PASSWORD=

NPM_ACCOUNT_USERNAME=
NPM_ACCOUNT_PASSWORD=

MERCADOPAGO_DASHBOARD_USERNAME=
MERCADOPAGO_DASHBOARD_PASSWORD=

RAPYD_DASHBOARD_USERNAME=
RAPYD_DASHBOARD_PASSWORD=

WOMPI_DASHBOARD_USERNAME=
WOMPI_DASHBOARD_PASSWORD=

RENDER_DASHBOARD_USERNAME=
RENDER_DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# 2. API keys de sandbox — las que consumen las pruebas de contrato
# ---------------------------------------------------------------------------

# Wompi es la única de las cuatro con cuatro secretos, y los dos últimos no son
# intercambiables: INTEGRITY firma las transacciones que salen y EVENTS valida
# los webhooks que entran. Sin INTEGRITY, Wompi responde
# 422 "Firma de integridad requerida no enviada" y no crea nada (punto 50).
# La API de Simulación verifica la firma con este mismo secreto; sin él, con su
# valor por omisión, test_integrity_kit_pagos_simulator (punto 86).
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Rapyd firma cada petición, no solo los webhooks: el par de claves se usa para
# calcular un HMAC por llamada. La API de Simulación verifica esa firma con este
# mismo secreto; sin él, con su valor por omisión, rapyd_secret_kit_pagos_simulator
# (punto 86).
RAPYD_API_ACCESS_KEY=
RAPYD_API_SECRET_KEY=
# URL registrada en el panel de Rapyd para recibir webhooks, escrita exactamente igual
# que allí. Rapyd la incluye en la firma y no la envía, así que sin ella ningún webhook
# de Rapyd se puede verificar (punto 67).
RAPYD_WEBHOOK_URL=

# En Mercado Pago el ACCESS_TOKEN es el que autentica las llamadas del servidor;
# el PUBLIC_KEY es para tokenizar la tarjeta en el frontend.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Kushki los llama "merchant id" pero funcionan como claves pública y privada.
KUSHKI_PUBLIC_MERCHANT_ID=
KUSHKI_PRIVATE_MERCHANT_ID=
KUSHKI_WEBHOOK_SECRET=

RENDER_DEPLOY_HOOK_URL=

# ---------------------------------------------------------------------------
# 3. Variables de la API de Simulación (REST Wrapper)
# ---------------------------------------------------------------------------
# API_AUTH_TOKEN: Token Bearer requerido para proteger los endpoints REST (/v1/api/*)
# de simulator-api. Si no se define, opera en modo desarrollo abierto sin exigir auth.
# Nota: /health y los endpoints mock /v1/sim/* quedan exentos.
API_AUTH_TOKEN=

# SIMULATOR_SDK_BASE_URL: URL base pública o interna para que las peticiones al
# simulador apunten al propio despliegue (ej. en Render: https://kit-pagos-colombia.onrender.com).
# Si no se define, usa el propio proceso: http://localhost:${PORT}/v1/sim/<pasarela> (3000 sin PORT).
# Nota: La resolución de ambientes para pasarelas reales (sandbox o production) se
# declara dinámicamente por petición mediante la cabecera 'x-kit-pagos-environment'
# y se resuelve contra un catálogo cerrado en el SDK (Issue #123).
SIMULATOR_SDK_BASE_URL=

# SIMULATOR_PUBLIC_ORIGIN: origen público del simulador (protocolo://host, sin ruta) para las
# URL que entrega a quien lo usa: la del banco del PSE de Wompi, la del checkout de Rapyd y el
# permalink de los términos de Wompi. Hace falta detrás de un proxy que termina TLS, como
# Render (ej. https://kit-pagos-colombia.onrender.com). Si no se define, usa el protocolo y el
# Host de cada petición. Un valor inválido detiene el arranque.
SIMULATOR_PUBLIC_ORIGIN=

# WEBHOOK_TOLERANCE_SECONDS: ventana contra reenvíos de POST /v1/api/webhooks/:gateway,
# en segundos. Si no se define, usa la del SDK (300); 0 la desactiva. Es configuración
# del servidor a propósito: ninguna petición puede ampliarla.
WEBHOOK_TOLERANCE_SECONDS=

