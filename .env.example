# Copia este archivo como ".env" en la raíz del repo y completa los valores
# reales. El archivo ".env" NUNCA debe subirse a git (ya está en .gitignore).
#
# Sección 1: credenciales de acceso a los dashboards de cada proveedor.
# Uso: administración de cuentas, obtención de API keys, configuración de
# webhooks. NO son las credenciales que el SDK usa para llamar a cada API.
#
# Sección 2: API keys / secrets de sandbox que el SDK y la API de Simulación
# consumirán en tiempo de ejecución. Se obtienen DENTRO de cada dashboard
# (sección 1) y todavía no han sido recolectadas — cada persona que las
# obtenga debe completarlas aquí y avisar al equipo.

# ---------------------------------------------------------------------------
# 1. Credenciales de acceso a dashboards
# ---------------------------------------------------------------------------

KUSHKI_DASHBOARD_USERNAME=
KUSHKI_DASHBOARD_PASSWORD=

NPM_ACCOUNT_USERNAME=
NPM_ACCOUNT_PASSWORD=

MERCADOPAGO_DASHBOARD_USERNAME=
MERCADOPAGO_DASHBOARD_PASSWORD=

PAYU_DASHBOARD_USERNAME=
PAYU_DASHBOARD_PASSWORD=

WOMPI_DASHBOARD_USERNAME=
WOMPI_DASHBOARD_PASSWORD=

RENDER_DASHBOARD_USERNAME=
RENDER_DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# 2. API keys / secrets de sandbox (pendientes de recolectar por gateway)
# ---------------------------------------------------------------------------

# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# WOMPI_INTEGRITY_SECRET=
# WOMPI_EVENTS_SECRET=

# PAYU_API_KEY=
# PAYU_API_LOGIN=
# PAYU_MERCHANT_ID=
# PAYU_ACCOUNT_ID=

# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_WEBHOOK_SECRET=

# KUSHKI_PUBLIC_MERCHANT_ID=
# KUSHKI_PRIVATE_MERCHANT_ID=

# RENDER_DEPLOY_HOOK_URL=
