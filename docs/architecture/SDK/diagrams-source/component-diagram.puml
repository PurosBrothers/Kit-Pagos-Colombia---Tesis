@startuml Component Diagram - SDK
title Diagrama de Componentes — SDK Kit Pagos Colombia (Nivel 3)
skinparam backgroundColor white
skinparam rectangleFontSize 11
skinparam wrapWidth 190
skinparam rectangle {
  BorderColor #666666
  ArrowColor #666666
  FontColor white
}

rectangle "**Desarrollador**\n\nConsume el SDK para\nintegrar pasarelas de pago" as Dev #1F4E79

rectangle "SDK Kit Pagos Colombia (Paquete npm / TypeScript)\n[container]" as System #FFFFFF {
  rectangle "**KitPagos**\n<i>[Facade Pattern]\nTypeScript</i>\n\nPunto de entrada unico.\ncreatePayment(),\ngetPaymentStatus(),\nvalidateWebhook()" as Facade #1F4E79
  rectangle "**SDK Configurator**\n<i>[Configuration Module]\nTypeScript</i>\n\nGestiona pasarela activa,\ncredenciales y modo\n(produccion/simulacion)" as Configurator #2E75B6
  rectangle "**Gateway Factory**\n<i>[Factory Pattern]\nTypeScript</i>\n\nInstancia adaptador segun\nel enum Gateway\nconfigurado" as Factory #2E75B6
  rectangle "**Payment Gateway Port**\n<i>[Interfaz / Puerto]\nTypeScript</i>\n\nContrato abstracto con las\noperaciones que debe\nimplementar cada adaptador" as Port #90CAF9

  rectangle "**Response Normalizer**\n<i>[Domain Service]\nTypeScript</i>\n\nMapea estados nativos a\nTransactionStatus y\nconstruye la entidad\nTransaction" as Normalizer #2E75B6
  rectangle "**Retry Handler**\n<i>[Resilience Utility]\nTypeScript</i>\n\nReintentos con backoff\nexponencial ante errores\ntransitorios" as Retry #2E75B6
  rectangle "**Error Handler**\n<i>[Domain Service]\nTypeScript</i>\n\nConvierte errores nativos\nen SdkError tipado con\nSdkErrorCode" as ErrorHandler #2E75B6
  rectangle "**Webhook Verifier**\n<i>[Domain Service]\nTypeScript</i>\n\nVerifica firmas\ncriptograficas\n(SHA-256, HMAC)" as Webhook #2E75B6
  rectangle "**Transaction Entity**\n<i>[Domain Entity]\nTypeScript</i>\n\nEncapsula estado unificado,\nmontos, autorizacion y\ndatos del pagador" as Transaction #FFE0B2

  rectangle "**Wompi Adapter**\n<i>[Adapter Pattern]</i>\n\nTraduce a Wompi\n(Bearer, status)" as WompiAdapter #5B9BD5
  rectangle "**Rapyd Adapter**\n<i>[Adapter Pattern]</i>\n\nTraduce a Rapyd\n(access_key/secret_key,\nHMAC-SHA256)" as RapydAdapter #5B9BD5
  rectangle "**Mercado Pago Adapter**\n<i>[Adapter Pattern]</i>\n\nTraduce a Mercado Pago\n(Bearer, status_detail)" as MPAdapter #5B9BD5
  rectangle "**Kushki Adapter**\n<i>[Adapter Pattern]</i>\n\nTraduce a Kushki\n(Private-Merchant-ID)" as KushkiAdapter #5B9BD5
}

rectangle "**Wompi API**\nBancolombia Sandbox" as WompiAPI #A9A9A9
rectangle "**Rapyd API**\nLatam Sandbox" as RapydAPI #A9A9A9
rectangle "**Mercado Pago API**\nMercado Libre Sandbox" as MPAPI #A9A9A9
rectangle "**Kushki API**\nUAT Sandbox" as KushkiAPI #A9A9A9
rectangle "**API de Simulacion**\nSimulador desplegado\n(Render). Destino\nprincipal durante\nevaluacion" as SimAPI #808080

Dev --> Facade : Invoca operaciones\nde pago\n[TypeScript]

Facade --> Configurator : Usa entorno
Facade --> Factory : Solicita adapter
Facade --> Retry : Envuelve llamada
Facade ..> Webhook : Valida webhook
Facade --> Normalizer : Normaliza respuesta
Factory ..> Port : Instancia

WompiAdapter ..|> Port
RapydAdapter ..|> Port
MPAdapter ..|> Port
KushkiAdapter ..|> Port

Retry --> ErrorHandler : MAX_RETRIES_EXCEEDED
Normalizer --> Transaction : Construye

WompiAdapter --> WompiAPI : Nativo\n[HTTPS]
RapydAdapter --> RapydAPI : Nativo\n[HTTPS]
MPAdapter --> MPAPI : Nativo\n[HTTPS]
KushkiAdapter --> KushkiAPI : Nativo\n[HTTPS]

WompiAdapter ..> SimAPI : Modo simulacion
RapydAdapter ..> SimAPI : Modo simulacion
MPAdapter ..> SimAPI : Modo simulacion
KushkiAdapter ..> SimAPI : Modo sandbox UAT

note bottom of RapydAdapter
  Reemplaza a "PayU Adapter" tras la adquisicion
  (ver architecture-log.md, punto 15).
end note

@enduml
