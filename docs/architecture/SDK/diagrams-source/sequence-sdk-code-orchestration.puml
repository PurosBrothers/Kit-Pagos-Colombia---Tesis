@startuml Sequence Diagram - SDK Code Orchestration
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 10
skinparam titleFontSize 11
skinparam ParticipantFontSize 10
skinparam ActorFontSize 10
skinparam ArrowFontSize 10
skinparam NoteFontSize 10
skinparam SequenceGroupFontSize 10
skinparam SequenceGroupHeaderFontSize 10
skinparam SequenceDividerFontSize 10
skinparam maxMessageSize 120
hide footbox
skinparam sequenceMessageAlign center
skinparam ArrowColor #666666
skinparam LifeLineBorderColor #666666

actor "Comercio" as C
participant "KitPagos" as K
participant "Sdk\nConfigurator" as Cfg
participant "Gateway\nFactory" as F
participant "Adaptador" as A
participant "Response\nNormalizer" as N
participant "Error\nHandler" as E
participant "Pasarela" as P

C -> K : createPayment(\nrequest)
K -> Cfg : getActiveGateway()
K -> K : valida request
K -> Cfg : credenciales,\nURL base,\ntimeout
K -> F : adapter = create(...)
K -> A : createPayment(request)
A -> P : fetch()
P --> A : respuesta HTTP
alt respuesta con el pago
  A -> N : transaction =\nnormalize(\nraw, gateway)
  A --> K : PaymentResult
  K --> C : PaymentResult
else error HTTP, de red o timeout
  A -> E : error = handle(\nfallo, gateway)
  A --> K : throw KitPagosError
  K --> C : throw\nKitPagosError
end

C -> K : getPaymentStatus(\nid)
K -> K : resolveAdapter()
group RetryHandler.execute() [reintenta los fallos RETRIABLE]
  K -> A : getStatus(id)
  A -> P : fetch()
  P --> A : respuesta HTTP
  A -> N : transaction =\nnormalize(\nraw, gateway)
  A --> K : Transaction
end
K --> C : Transaction
@enduml
