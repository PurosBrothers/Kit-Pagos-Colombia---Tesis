@startuml Sequence Diagram - Synchronous Payment
title B - Pago Sincrono (Kushki - Tarjeta)
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam defaultFontSize 10
skinparam titleFontSize 11
skinparam ParticipantFontSize 10
skinparam ActorFontSize 10
skinparam ArrowFontSize 10
skinparam NoteFontSize 10
skinparam SequenceGroupFontSize 10
skinparam SequenceGroupHeaderFontSize 10
skinparam SequenceDividerFontSize 10
skinparam maxMessageSize 120
hide footbox
skinparam sequenceMessageAlign center
skinparam ArrowColor #666666
skinparam LifeLineBorderColor #666666

participant "Comercio" as Comercio
participant "KitPagos\n(Facade)" as Facade
participant "KushkiAdapter" as Kushki
participant "Kushki API" as API

Comercio -> Facade : createPayment(request)
Facade -> Kushki : createPayment(request)
Kushki -> API : POST /card/v1/charges

alt Pago aprobado
  API --> Kushki : HTTP 201
  rnote over Kushki: transaction_status = APPROVAL
  Kushki -> Kushki : ResponseNormalizer.\nnormalize(rawResponse,\ngateway)
  Kushki --> Facade : PaymentResult
  Facade --> Comercio : PaymentResult(\nTRANSACTION:\nstatus=APPROVED)
else Pago rechazado
  API --> Kushki : HTTP 402
  rnote over Kushki: transaction_status = DECLINED
  Kushki -> Kushki : ResponseNormalizer.\nnormalize(rawResponse,\ngateway)
  Kushki --> Facade : PaymentResult
  Facade --> Comercio : PaymentResult(\nTRANSACTION:\nstatus=DECLINED)
else Error tecnico
  API --> Kushki : HTTP 500
  Kushki --> Facade : error nativo
  Facade --> Comercio : throw KitPagosError(\nGATEWAY_SERVER_ERROR)
end

note over Comercio, API
  Excepcion al patron "pendiente + webhook": para
  tarjeta, Kushki devuelve el resultado final en
  la misma respuesta HTTP, sin conciliacion
  posterior. Esta particularidad la absorbe
  KushkiAdapter; no se filtra hacia el codigo
  del comercio.
end note

@enduml