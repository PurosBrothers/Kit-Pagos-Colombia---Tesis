@startuml Sequence Diagram - Denied Payment
title Escenario 2 - Pago Rechazado (Simulator API)
skinparam backgroundColor white
skinparam sequenceMessageAlign center
skinparam ArrowColor #666666
skinparam LifeLineBorderColor #666666

participant "Comercio\n(Backend)" as Comercio
participant "SDK KitPagos" as SDK
participant "Simulator API\n(Fastify)" as SimAPI
participant "GatewayMockFactory" as MockFactory
participant "TransactionStore" as Store

Comercio -> SDK : createPayment(CreatePaymentRequest)
SDK -> SimAPI : POST /v1/sim/{gateway}/payments
SimAPI -> MockFactory : buildRejectedResponse(gateway, request)
MockFactory -> MockFactory : Genera payload nativo de rechazo\n(Wompi: {data:{id,status:"DECLINED",\nstatus_message:"Fondos insuficientes"}},\nMercado Pago: {id,status:"rejected",\nstatus_detail:"cc_rejected_insufficient_amount"},\nRapyd: {data:{id,status:"ERR",\nfailure_code:"INSUFFICIENT_FUNDS"}},\nKushki: {ticketNumber,details:{transactionStatus:"DECLINED"}})
MockFactory -> Store : save(gatewayTransactionId, payload)
Store --> MockFactory : OK
MockFactory --> SimAPI : payload nativo de rechazo
SimAPI --> SDK : HTTP 201 / 200 (payload nativo)
SDK -> SDK : ResponseNormalizer.normalize(payload, gateway)
SDK --> Comercio : PaymentResult(TRANSACTION: status=DECLINED,\nrejectionReason={category, code})

note over Comercio, Store
  El simulador almacena la transaccion rechazada en
  TransactionStore para que sea consultable via
  GET /v1/sim/{gateway}/transactions/{id}.
  El estado DECLINED se normaliza a partir del codigo
  nativo de rechazo de cada pasarela mediante
  RejectionCategory del dominio.
end note

@enduml
