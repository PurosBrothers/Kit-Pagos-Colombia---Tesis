    "kushki"
  ],
  "author": "Andres Henao, Joan Orduz, Joshua Prieto, David Rodriguez",
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2"
  }
}