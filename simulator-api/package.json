{
  "name": "simulator-api",
  "version": "0.1.0",
  "description": "API web de simulación de pasarelas de pago para Kit Pagos Colombia.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\""
  },
  "keywords": [
    "pasarelas-de-pago",
