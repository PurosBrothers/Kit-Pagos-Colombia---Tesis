    {
      "name": "04. Simulador Rapyd (/v1/sim/rapyd)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Firma Rapyd: la misma fórmula de sdk/src/infrastructure/adapters/rapyd-signature.ts.",
              "// La página GET /checkout/:id/pay es del simulador y no lleva firma.",
              "if (pm.request.url.path[pm.request.url.path.length - 1] === \"pay\") { return; }",
              "const secret = pm.environment.get(\"rapydSecretKey\") || \"rapyd_secret_kit_pagos_simulator\";",
              "const accessKey = pm.environment.get(\"rapydAccessKey\");",
              "if (pm.request.body && pm.request.body.raw) {",
              "  pm.request.body.raw = JSON.stringify(JSON.parse(pm.variables.replaceIn(pm.request.body.raw)));",
              "}",
              "const body = (pm.request.body && pm.request.body.raw) || \"\";",
              "const query = pm.request.url.getQueryString();",
              "const path = \"/\" + pm.request.url.path.map((s) => pm.variables.replaceIn(s)).join(\"/\") + (query ? \"?\" + pm.variables.replaceIn(query) : \"\");",
              "const salt = CryptoJS.lib.WordArray.random(8).toString(CryptoJS.enc.Hex);",
              "const timestamp = Math.floor(Date.now() / 1000).toString();",
              "const toSign = pm.request.method.toLowerCase() + path + salt + timestamp + accessKey + secret + body;",
              "const hex = CryptoJS.HmacSHA256(toSign, secret).toString(CryptoJS.enc.Hex);",
              "const signature = CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(hex));",
              "pm.request.headers.upsert({ key: \"salt\", value: salt });",
              "pm.request.headers.upsert({ key: \"timestamp\", value: timestamp });",
              "pm.request.headers.upsert({ key: \"signature\", value: signature });"
            ]
          }
        }
      ],
