{
  "info": {
    "_postman_id": "8c12e345-0001-4a56-b789-kitpagos0001",
    "name": "Kit Pagos Colombia - Simulator API",
    "description": "Colección versionada de la API de Simulación de Kit Pagos Colombia (issue #131). Cubre /health, los 5 endpoints de /v1/api, las rutas /v1/sim de Wompi, Mercado Pago, Rapyd y Kushki, y el trigger de webhooks. Las carpetas se ejecutan en orden: cada creación guarda su id en el ambiente y la consulta siguiente lo usa. Sin credenciales: los secretos van en el ambiente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// El trigger y la verificación de webhooks tienen sus propias aserciones:",
          "if (pm.info.requestName === \"POST /v1/sim/webhooks/trigger\" || pm.info.requestName === \"POST /v1/api/webhooks/:gateway\") { return; }",
          "pm.test(`${pm.info.requestName}: responde 2xx`, () => { pm.expect(pm.response.code).to.be.within(200, 299); });"
        ]
      }
    }
  ],
