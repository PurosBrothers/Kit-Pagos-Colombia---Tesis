    {
      "name": "06. Webhooks",
      "description": "Requiere haber corrido antes la carpeta de Wompi: el trigger firma la transacción {{wompiTransactionId}}.",
      "item": [
        {
          "name": "POST /v1/sim/webhooks/trigger",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiAuthToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/sim/webhooks/trigger",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "sim",
                "webhooks",
                "trigger"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gateway\": \"wompi\",\n  \"transactionId\": \"{{wompiTransactionId}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 200 si hay SIMULATOR_WEBHOOK_TARGET_URL; 409 si falta destino o secreto en el servidor.",
                  "pm.test(\"POST /v1/sim/webhooks/trigger: responde 200 o 409\", () => {",
                  "  const json = pm.response.json();",
                  "  const ok = pm.response.code === 200 || (pm.response.code === 409 && (json.code === \"WEBHOOK_TARGET_NOT_CONFIGURED\" || json.code === \"WEBHOOK_SECRET_NOT_CONFIGURED\"));",
                  "  pm.expect(ok, `código ${pm.response.code}`).to.be.true;",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.webhook && json.webhook.body) {",
                  "  pm.environment.set(\"webhookBody\", json.webhook.body);",
                  "  pm.environment.set(\"webhookChecksum\", (json.webhook.headers && json.webhook.headers[\"x-event-checksum\"]) || \"\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/api/webhooks/:gateway",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiAuthToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Event-Checksum",
                "value": "{{webhookChecksum}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/api/webhooks/wompi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "api",
                "webhooks",
                "wompi"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{{webhookBody}}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Si el trigger firmó un webhook, la verificación responde 200; si el servidor no tiene secreto, responde 401.",
                  "pm.test(\"POST /v1/api/webhooks/:gateway: responde 2xx o 401\", () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 401]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
