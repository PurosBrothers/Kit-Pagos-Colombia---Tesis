{
  "name": "kit-pagos-colombia",
  "version": "0.2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:node": "tsc -p tsconfig.build.json",
    "build:browser": "tsc -p tsconfig.browser.json && node scripts/build-browser.js",
    "build": "npm run clean && npm run build:node && npm run build:browser",
    "prepublishOnly": "npm test && npm run build",
    "test": "jest",
    "test:sandbox": "jest --config jest.sandbox.config.js",
    "lint": "eslint .",
    "metrics": "ts-node --project tsconfig.json scripts/ck-metrics.ts",
    "check:readme": "ts-node --project tsconfig.json scripts/check-readme.ts",
    "check:published": "ts-node --project tsconfig.json scripts/check-published-package.ts"
  },
  "keywords": [
    "pagos",
    "colombia",
    "sdk",
    "wompi",
    "mercadopago",
    "kushki",
    "rapyd",
    "pse",
    "fintech",
    "pasarelas-de-pago"
  ],
  "author": "Grupo 22",
  "license": "Apache-2.0",
  "description": "SDK unificado de pasarelas de pago para Colombia (Wompi, Mercado Pago, Kushki, Rapyd) con arquitectura hexagonal y tipos TypeScript estrictos.",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PurosBrothers/Kit-Pagos-Colombia---Tesis.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/PurosBrothers/Kit-Pagos-Colombia---Tesis/issues"
  },
  "homepage": "https://github.com/PurosBrothers/Kit-Pagos-Colombia---Tesis#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/big.js": "^7.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "big.js": "^7.0.1",
    "caniuse-lite": "^1.0.30001814"
  }
}
